POSTGRES_DB=yingshi
POSTGRES_USER=yingshi
POSTGRES_PASSWORD=yingshi_dev_password
POSTGRES_HOST_PORT=15432

MINIO_ROOT_USER=yingshi_minio_access
MINIO_ROOT_PASSWORD=yingshi_minio_secret
MINIO_BUCKET=yingshi-media

SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/yingshi
SPRING_DATASOURCE_USERNAME=yingshi
SPRING_DATASOURCE_PASSWORD=yingshi_dev_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1

STORAGE_PROVIDER=s3
STORAGE_BUCKET=yingshi-media
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=yingshi_minio_access
STORAGE_SECRET_KEY=yingshi_minio_secret
STORAGE_CDN_DOMAIN=
STORAGE_CDN_AUTH_KEY=
STORAGE_CDN_SIGN_PARAM=sign
STORAGE_CDN_TIMESTAMP_PARAM=t
STORAGE_SIGNED_URL_TTL=PT15M
STORAGE_DIRECT_UPLOAD_ENABLED=true
STORAGE_DIRECT_UPLOAD_PUBLIC_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=true

APP_AUTH_JWT_SECRET=change-me-to-a-long-dev-secret-at-least-32-characters
APP_PRODUCTION_SAFETY_ENABLED=false

# CORS: Comma-separated list of allowed origins for production.
# Leave empty to reject cross-origin browser requests. Production startup requires an explicit HTTPS list.
# Example: APP_CORS_ALLOWED_ORIGINS=https://yingshi.example.com,https://admin.example.com
APP_CORS_ALLOWED_ORIGINS=

SERVER_PORT=8080
SERVER_HOST_PORT=8080

AUTH_MAIL_ENABLED=true
AUTH_MAIL_HOST=smtp.qq.com
AUTH_MAIL_PORT=587
AUTH_MAIL_USERNAME=1085060329@qq.com
AUTH_MAIL_PASSWORD=replace-with-qq-smtp-auth-code
AUTH_MAIL_FROM_ADDRESS=1085060329@qq.com
AUTH_MAIL_FROM_NAME=映世
AUTH_MAIL_AUTH=true
AUTH_MAIL_STARTTLS=true

# Optional Firebase Cloud Messaging.
# Keep service-account JSON outside git; point to the file or provide base64 JSON via your secret manager.
FCM_ENABLED=false
FCM_DRY_RUN=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_HOST_PATH=
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON_BASE64=
