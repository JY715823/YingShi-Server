<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATH" value="${LOG_PATH:-${java.io.tmpdir:-/tmp}/yingshi-logs}"/>
    <property name="LOG_FILE" value="${LOG_PATH}/yingshi-server"/>

    <!-- R0-H: Global log masking converter for lat/lng and token redaction.
         Registered for use in pattern-based appenders via %masked.
         LogstashEncoder (JSON) relies on source-level masking in services. -->
    <conversionRule conversionWord="masked" converterClass="com.yingshi.server.config.logging.MaskingConverter"/>

    <!-- Console: human-readable for dev, JSON for prod -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>libraryId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- Rolling JSON file for log aggregation -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>libraryId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- Dev profile: readable console + JSON file -->
    <springProfile name="dev | docker-local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.yingshi.server" level="DEBUG"/>
    </springProfile>

    <!-- Production profiles: JSON file only (no console noise) -->
    <springProfile name="prod | production | cloud | tencent">
        <root level="INFO">
            <appender-ref ref="JSON_FILE"/>
        </root>
        <logger name="com.yingshi.server" level="INFO"/>
    </springProfile>

    <!-- Docker profile (non-local): JSON file + console -->
    <springProfile name="docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
        <logger name="com.yingshi.server" level="INFO"/>
    </springProfile>
</configuration>
